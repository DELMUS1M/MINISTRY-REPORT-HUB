# Public (safe for the browser) — from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Name shown in the header and on generated report cards
NEXT_PUBLIC_CONGREGATION_NAME="Your Congregation Name"

# Server-only — used by the Supabase Edge Function, never expose to the browser.
# Set this as a secret on Supabase (supabase secrets set SECRETARY_ACCESS_CODE=...),
# NOT here. This file only documents that it exists.
# SECRETARY_ACCESS_CODE=choose-a-private-code
